<?xml version="1.0" encoding="UTF-8"?>
<!--
  Config IIS pour servir le build statique de l'application (dossier dist/).
  Copié automatiquement dans dist/ à chaque `npm run build` (Vite copie tout
  le contenu de public/ tel quel).
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Pas de contenu dynamique : le pool d'applications IIS doit être en
         "No Managed Code". -->
    <staticContent>
      <!-- Cache court par défaut (index.html, favicon) pour ne jamais servir
           une page obsolète pointant vers des assets déjà remplacés. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:05:00" />
    </staticContent>
  </system.webServer>

  <!-- Les fichiers sous assets/ sont nommés avec un hash de contenu par
       Vite : un changement de contenu change le nom de fichier, donc un
       cache long est sans risque. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
